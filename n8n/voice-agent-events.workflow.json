      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const event = $json.body ?? $json;\nconst allowed = new Set(['call_completed', 'callback_requested', 'dnc_recorded', 'call_failed']);\nif (!allowed.has(event.event)) throw new Error('Unsupported voice-agent event');\nif (!event.eventId || !event.contactId) throw new Error('Missing eventId or contactId');\nreturn [{ json: { ...event, receivedAt: new Date().toISOString() } }];"
      },
      "id": "c21d82e9-2178-4cbf-90df-1e497cb96d0e",
      "name": "Validate event envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.event }}", "rightValue": "callback_requested", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "Callback" },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.event }}", "rightValue": "dnc_recorded", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "DNC" },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.event }}", "rightValue": "call_failed", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "Failure" }
          ]
        },
        "options": { "fallbackOutput": "other" }
      },
      "id": "5fcc6d67-47a1-4c70-8827-1cd6f03c6a5c",
      "name": "Route event type",
